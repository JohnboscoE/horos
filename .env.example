# ---- Network --------------------------------------------------------------
# testnet | mainnet. Never share keys or databases between networks.
NETWORK=testnet
# Comma-separated RPC URLs, tried in order with failover. Empty = defaults from @horos/core chain config.
ARC_RPC_URLS=

# ---- Database -------------------------------------------------------------
# Postgres connection string. Empty = embedded PGlite at ./.pglite/<NETWORK> (local dev only).
DATABASE_URL=

# ---- Circle Developer-Controlled Wallets ---------------------------------
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
# true = in-memory fake Circle client (local dev / tests)
MOCK_CIRCLE=true

# ---- Attester (writes PaymentRecord + DecisionAnchor, signs decision log) --
ATTESTER_PRIVATE_KEY=
# Comma-separated addresses of rotated-out attester keys, still trusted for verifying old log entries.
PREVIOUS_LOG_SIGNERS=
PAYMENT_RECORD_ADDRESS=
DECISION_ANCHOR_ADDRESS=

# ---- Contract deployment (forge script contracts/script/Deploy.s.sol) ----
# Deployer pays gas (USDC on Arc) and becomes the contracts' owner. Testnet keys only.
DEPLOYER_PRIVATE_KEY=
OWNER_ADDRESS=
ATTESTER_ADDRESS=

# ---- Agent ----------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# true = deterministic stub, no API calls
MOCK_AGENT=true

# ---- Onramp (Arc App Kit: client pays by card / bank → USDC to the invoice deposit address) ----
# Default on. With MOCK_CIRCLE=true it runs as a local preview (simulated purchase).
ONRAMP_ENABLED=true
# Defaults to CIRCLE_API_KEY. Sandbox and production keys are separate.
ONRAMP_API_KEY=
# Domain the widget is embedded on (defaults to the PUBLIC_WEB_URL / WEB_ORIGIN host).
ONRAMP_REFERRER_DOMAIN=

# ---- Safety ---------------------------------------------------------------
# Halts executor and attester when true.
KILL_SWITCH=false
# Per-invoice cap in USDC (whole units). Mainnet gate requires one.
MAX_INVOICE_USDC=500

# ---- API ------------------------------------------------------------------
PORT=8787
WEB_ORIGIN=http://localhost:5173
