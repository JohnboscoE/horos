{
  "name": "horos",
  "private": true,
  "version": "0.1.0",
  "description": "Know which clients pay late before you start the work.",
  "engines": {
    "node": ">=20.18.2"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:contracts": "forge test --root contracts",
    "dev:api": "pnpm --filter @horos/api dev",
    "dev:worker": "pnpm --filter @horos/api worker",
    "dev:web": "pnpm --filter @horos/web dev",
    "seed": "pnpm --filter @horos/api seed"
  }
}
